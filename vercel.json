{
    "version": 2,
    "name": "bookshelf",
    "builds": [
      {
        "src": "mern-client/package.json",
        "use": "@vercel/static-build",
        "config": {
          "distDir": "mern-client/dist",
          "buildCommand": "npm run build", 
          "outputDirectory": "dist"
        }
      },
      {
        "src": "mern-server/index.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "/mern-server/index.js"
      },
      {
        "src": "/(.*)",
        "dest": "/mern-client/dist/index.html"
      }
    ]
  }
  